{
  "name": "llm-staff-app",
  "version": "0.10.3",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "electron-updater": "^6.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.datalab.llmstaff",
    "productName": "Datalab90 Staff",
    "files": [
      "**/*"
    ],
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "renderer/assets/app.ico",
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://192.168.35.248:8000/updates/"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
